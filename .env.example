# file (default, local data/db.json) or firebase
STORAGE=file
PORT=3000

# --- Firebase (set STORAGE=firebase) ---
# Firebase console > Project settings > Service accounts > Generate new private key
# Either a path to the JSON key file, or the JSON itself:
FIREBASE_SERVICE_ACCOUNT=./firebase-key.json
# OPTIONAL. Firebase Storage needs the paid Blaze plan. Leave blank and photos are stored
# in Firestore instead, which works on the free Spark plan.
FIREBASE_STORAGE_BUCKET=
# Optional: prefix collections, e.g. "kitchen_"
FIREBASE_COLLECTION_PREFIX=
